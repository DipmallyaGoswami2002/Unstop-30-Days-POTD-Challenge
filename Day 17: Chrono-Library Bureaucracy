Input Format
The first line contains a single integer Q, representing the total number of operational updates and inspector requests.

Each of the next Q lines starts with an integer T, denoting the event type (1, 2, or 3).

For events of type 1 and 2, the integer T is followed by a space and another integer W, indicating the chronological weight of the record. For type 3, no other integer follows.

Output Format
For each event of type 3, print a single integer on a new line representing the calculated audit weight. If an audit is requested when the wing contains no records, print -1.

Solution : 

#include <iostream>
#include <ext/pb_ds/assoc_container.hpp>
#include <ext/pb_ds/tree_policy.hpp>

using namespace std;
using namespace __gnu_pbds;

typedef tree<
    long long,
    null_type,
    less<long long>,
    rb_tree_tag,
    tree_order_statistics_node_update>
    ordered_set;

void solve() {
    int Q;
    if (!(cin >> Q)) return;

    ordered_set active_set;

    while (Q--) {
        int type;
        cin >> type;

        if (type == 1) {
            long long W;
            cin >> W;
            active_set.insert(W);
        } 
        else if (type == 2) {
            long long W;
            cin >> W;
            active_set.erase(W);
        } 
        else if (type == 3) {
            int M = active_set.size();
            if (M == 0) {
                cout << -1 << "\n";
            } else if (M % 2 == 1) {
                long long median = *active_set.find_by_order(M / 2);
                cout << median << "\n";
            } else {
                
                long long mid1 = *active_set.find_by_order((M / 2) - 1);
                long long mid2 = *active_set.find_by_order(M / 2);
                long long median = (mid1 + mid2) / 2;
                cout << median << "\n";
            }
        }
    }
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    solve();
    return 0;
}
