Solution : 

// Code
#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

struct Query {
    char type;
    long long arg1;
    long long arg2;
};

struct FenwickTree {
    int size;
    vector<int> tree;

    FenwickTree(int n) : size(n), tree(n + 1, 0) {}

    void add(int i, int delta) {
        for (; i <= size; i += i & -i) {
            tree[i] += delta;
        }
    }

    int query(int i) {
        int sum = 0;
        for (; i > 0; i -= i & -i) {
            sum += tree[i];
        }
        return sum;
    }

    int find_kth(int k) {
        int idx = 0;
        for (int i = 1 << 18; i > 0; i >>= 1) {
            if (idx + i <= size && tree[idx + i] < k) {
                idx += i;
                k -= tree[idx];
            }
        }
        return idx + 1;
    }
};

int main() {

    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    if (!(cin >> n)) return 0;

    vector<long long> prices(n + 1);
    vector<long long> all_values;

    for (int i = 1; i <= n; ++i) {
        cin >> prices[i];
        all_values.push_back(prices[i]);
    }

    int q;
    cin >> q;

    vector<Query> queries(q);
    for (int i = 0; i < q; ++i) {
        cin >> queries[i].type;
        if (queries[i].type == 'U') {
            cin >> queries[i].arg1 >> queries[i].arg2;
            all_values.push_back(queries[i].arg2);
        } else if (queries[i].type == 'C') {
            cin >> queries[i].arg1;
            all_values.push_back(queries[i].arg1);
        } else if (queries[i].type == 'K') {
            cin >> queries[i].arg1;
        }
    }

    sort(all_values.begin(), all_values.end());
    all_values.erase(unique(all_values.begin(), all_values.end()), all_values.end());

    auto get_compressed_idx = [&](long long val) {
        return lower_bound(all_values.begin(), all_values.end(), val) - all_values.begin() + 1;
    };

    int total_unique = all_values.size();
    FenwickTree ft(total_unique);

    for (int i = 1; i <= n; ++i) {
        int compressed_idx = get_compressed_idx(prices[i]);
        ft.add(compressed_idx, 1);
    }

    for (int i = 0; i < q; ++i) {
        if (queries[i].type == 'U') {
            int stall_idx = queries[i].arg1;
            long long new_price = queries[i].arg2;

            int old_compressed_idx = get_compressed_idx(prices[stall_idx]);
            ft.add(old_compressed_idx, -1);

            prices[stall_idx] = new_price;

            int new_compressed_idx = get_compressed_idx(new_price);
            ft.add(new_compressed_idx, 1);

        } else if (queries[i].type == 'C') {
            long long threshold = queries[i].arg1;

            auto it = upper_bound(all_values.begin(), all_values.end(), threshold);
            int count_compressed = it - all_values.begin();

            if (count_compressed == 0) {
                cout << 0 << "\n";
            } else {
                cout << ft.query(count_compressed) << "\n";
            }

        } else if (queries[i].type == 'K') {
            int k = queries[i].arg1;
            int compressed_idx = ft.find_kth(k);
            cout << all_values[compressed_idx - 1] << "\n";
        }
    }

    return 0;
}
