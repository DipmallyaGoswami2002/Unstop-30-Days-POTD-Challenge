Problem Statement : After a powerful cyclone struck the coastal region of Navira, several villages were left without electricity, food supplies, and drinking water. The State Disaster Response Team immediately organized an emergency convoy to transport relief crates to the affected areas. Every village submitted a request specifying the number of relief crates it required and the latest day by which the convoy should reach the village. Deliveries arriving after the specified day would be of little use because alternate arrangements would already have been made.

Aarav, the convoy coordinator, has only one delivery truck available. The truck can visit at most one village in a single day, and every village can be visited only once. If the truck reaches a village on or before its requested day, all the crates requested by that village are considered successfully delivered. Otherwise, that village receives nothing from this convoy.

Since the number of requests is much larger than the number of available delivery days, Aarav must carefully prepare the delivery schedule. His objective is not to serve the largest number of villages, but to ensure that the convoy delivers the maximum possible number of relief crates before their respective deadlines.

Solulu :
// Code
#include <iostream>
#include <vector>
#include <algorithm>
#include <numeric>

using namespace std;

struct DSU {
    vector<int> parent;
    DSU(int n) {
        parent.resize(n + 1);
        iota(parent.begin(), parent.end(), 0);
    }

    int find(int i) {
        if (parent[i] == i)
            return i;
        return parent[i] = find(parent[i]);
    }

    void unite(int i, int j) {
        int root_i = find(i);
        int root_j = find(j);
        if (root_i != root_j) {
            parent[root_i] = root_j;
        }
    }
};

long long maximum_crates(const vector<pair<int, int>>& requests) {
    vector<pair<int, int>> sorted_reqs = requests;
    sort(sorted_reqs.begin(), sorted_reqs.end(), [](const pair<int, int>& a, const pair<int, int>& b) {
        if (a.second != b.second)
            return a.second > b.second;
        return a.first > b.first;
    });

    int max_day = 0;
    for (const auto& req : requests) {
        max_day = max(max_day, req.first);
    }

    DSU dsu(max_day);
    long long total_crates = 0;

    for (const auto& req : sorted_reqs) {
        int deadline = req.first;
        int crates = req.second;

        int available_day = dsu.find(deadline);

        if (available_day > 0) {
            total_crates += crates;
            dsu.unite(available_day, available_day - 1);
        }
    }

    return total_crates;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    if (!(cin >> n)) return 0;

    vector<pair<int, int>> requests(n);
    for (int i = 0; i < n; ++i) {
        cin >> requests[i].first >> requests[i].second;
    }

    long long result = maximum_crates(requests);
    cout << result << "\n";

    return 0;
}
