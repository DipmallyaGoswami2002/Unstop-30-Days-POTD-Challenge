#include <iostream>
#include <vector>
#include <algorithm>
#include <cmath>

using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int N;
    if (!(cin >> N)) return 0;

    vector<long long> X(N);
    for (int  i = 0; i < N; ++i) {
        cin >> X[i];
    }

    vector<long long> Th(N);
    for (int i = 0; i < N; ++i) {
        cin >> Th[i];
    }
    long long max_val = -2e18;
    long long min_val = 2e18;

    for (int i = 0; i < N; ++i) {
        max_val = max(max_val, X[i] + Th[i]);
        min_val = min(min_val, X[i] - Th[i]);
    }
    long long diff = max_val - min_val;

    long long min_P = (diff + 1) / 2;

    if (min_P < 0) {
        min_P = 0;
    }
    cout << min_P << "\n";
    return 0;
}
                            
